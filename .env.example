# Copy to .env (or export these) and adjust. Values shown are the defaults.

# Optional. Analysis only — collecting and browsing briefs work without it, and
# only the analyze step returns 503.
ANTHROPIC_API_KEY=

# Required for any non-loopback bind: the app refuses to start on HOST=0.0.0.0
# without it. Optional (and off) when bound to 127.0.0.1.
AUTH_TOKEN=

# Bind address. Leave on loopback unless you front the app with a TLS proxy.
HOST=127.0.0.1

# HTTP port.
PORT=6181

# Text model used for classification and synthesis.
JANUSLINE_MODEL=claude-sonnet-5

# Directory holding data/briefs/<slug>/ and the deleted-brief trash.
JANUSLINE_DATA=./data

# Age in days at which trashed briefs are purged on startup.
JANUSLINE_TRASH_DAYS=7

# 1 swaps in the offline fixture feeds and the offline analyst (demo/tests).
JANUSLINE_FAKE=
